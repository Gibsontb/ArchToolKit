{
  "terraform": { "required_providers": { "aws": { "source": "hashicorp/aws", "version": "~> 6.0" } } },
  "resource": {
    "aws_vpc": { "main": { "cidr_block": "10.0.0.0/16", "enable_dns_hostnames": true, "tags": { "Name": "main" } } },
    "aws_subnet": { "a": { "vpc_id": "${aws_vpc.main.id}", "cidr_block": "10.0.1.0/24" } }
  }
