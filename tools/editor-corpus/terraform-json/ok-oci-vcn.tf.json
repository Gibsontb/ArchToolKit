{
  "terraform": { "required_providers": { "oci": { "source": "oracle/oci", "version": "~> 9.0" } } },
  "variable": { "compartment_id": { "type": "string" } },
  "resource": {
    "oci_core_vcn": { "vcn": { "compartment_id": "${var.compartment_id}", "cidr_blocks": ["10.40.0.0/16"], "display_name": "app" } },
    "oci_core_subnet": { "a": { "compartment_id": "${var.compartment_id}", "vcn_id": "${oci_core_vcn.vcn.id}", "cidr_block": "10.40.1.0/24", "prohibit_public_ip_on_vnic": true } }
  }
}
