<?xml version="1.0" encoding="utf-8"?>
<!--
  ArchPad's one package (Microsoft.Web.WebView2) comes from nuget.org. This
  machine-independent source list keeps the build from depending on whatever
  feeds the developer's global NuGet config happens to have.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
